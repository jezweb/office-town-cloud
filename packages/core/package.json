{
	"name": "@office-town/core",
	"version": "0.1.0",
	"private": true,
	"description": "Office Town Cloud core Worker — Hono app exposing wiki, files, publish, cron, dashboard",
	"main": "src/index.ts",
	"scripts": {
		"dev": "wrangler dev",
		"deploy": "wrangler deploy",
		"db:generate": "drizzle-kit generate",
		"db:migrate:local": "wrangler d1 migrations apply office-town-d1 --local",
		"db:migrate:remote": "wrangler d1 migrations apply office-town-d1 --remote",
		"typecheck": "tsc --noEmit",
		"test": "vitest run"
	},
	"dependencies": {
		"@office-town/shared": "workspace:*",
		"better-auth": "^1.6.0",
		"drizzle-orm": "^0.45.2",
		"hono": "^4.6.0",
		"js-yaml": "^4.1.0",
		"nanoid": "^5.0.0"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^4.20250101.0",
		"@types/js-yaml": "^4.0.9",
		"@types/node": "^22.10.0",
		"drizzle-kit": "^0.31.10",
		"typescript": "^5.6.0",
		"vitest": "^2.1.0",
		"wrangler": "^3.85.0"
	}
}
