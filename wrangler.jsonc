{
	"$schema": "https://json.schemastore.org/wrangler.json",
	"name": "office-town",
	"main": "src/index.ts",
	"compatibility_date": "2026-05-01",
	"compatibility_flags": ["nodejs_compat"],
	"workers_dev": true,
	"observability": {
		"enabled": true,
		"logs": { "invocation_logs": true, "head_sampling_rate": 1 }
	},

	// On first self-deploy: run `wrangler d1 create office-town-d1` and paste
	// the returned id below. The "Deploy to Cloudflare" button on the README
	// substitutes the id automatically — placeholder is fine for that path.
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "office-town-d1",
			"database_id": "60e7db22-6570-41eb-9122-90656204b042",
			"migrations_dir": "drizzle"
		}
	],

	"r2_buckets": [
		{
			"binding": "WIKI",
			"bucket_name": "office-town-wiki",
			"preview_bucket_name": "office-town-wiki-preview"
		},
		{
			"binding": "FILES",
			"bucket_name": "office-town-files",
			"preview_bucket_name": "office-town-files-preview"
		}
	],

	// IMPORTANT: When deploying via the "Deploy to Cloudflare" button,
	// the form will ask you to fill in two Vectorize fields manually:
	//     Dimensions: 768
	//     Metric:     cosine
	// These match Workers AI's @cf/baai/bge-base-en-v1.5 embedding model.
	// The wrangler.jsonc schema explicitly forbids these as inline fields
	// (additionalProperties: false on vectorize bindings) so they can't
	// be pre-filled from this config.
	"vectorize": [
		{ "binding": "VECTOR_INDEX", "index_name": "office-town-vec" }
	],

	"ai": { "binding": "AI" },

	// Browser Rendering (puppeteer-compatible) — for JS-rendered page scraping
	// via files(action:fetch_with_js) + files(action:screenshot).
	"browser": { "binding": "BROWSER" },

	// Cloudflare Images — for resize/format-convert/strip-EXIF on uploads.
	// Free transformations up to 100k/month per zone. No API key needed.
	"images": { "binding": "IMAGES" },

	// Media Transformations — extract video frames + audio tracks server-side
	// (no ffmpeg) for vision/transcription. Per-Worker binding, public open
	// beta (transform ops unbilled during beta). Powers media-pipeline Phase C.
	"media": { "binding": "MEDIA" },

	// Outbound email via Cloudflare Email Routing — no API key required.
	// Requires Email Routing set up on the user's domain with destination
	// addresses verified. Email Routing is free up to 100 sends/day.
	// Falls back to SMTP2Go if SMTP2GO_API_KEY secret is set.
	"send_email": [
		{ "name": "SEND_EMAIL" }
	],

	// Sandbox MCP — Cloudflare Containers + @cloudflare/sandbox SDK.
	// Each call to getSandbox(env.SANDBOX, id) gets or creates a container
	// instance backed by a Durable Object. Same id across calls = persistent
	// session (auto-sleeps after sleepAfter idle). max_instances caps total
	// concurrent containers.
	"containers": [
		{
			"class_name": "Sandbox",
			"image": "./Dockerfile",
			"max_instances": 10
		}
	],

	"durable_objects": {
		"bindings": [
			{ "class_name": "Sandbox", "name": "SANDBOX" }
		]
	},

	"migrations": [
		{ "tag": "v1", "new_sqlite_classes": ["Sandbox"] }
	],

	"queues": {
		"producers": [
			{ "binding": "INDEX_QUEUE", "queue": "office-town-index" }
		],
		"consumers": [
			{
				"queue": "office-town-index",
				"max_batch_size": 10,
				"max_batch_timeout": 5,
				"max_retries": 3
			}
		]
	},

	"vars": {
		"ENVIRONMENT": "production",
		// Comma-separated email domains allowed to sign in via Google OAuth
		// (only matters if you wire GOOGLE_CLIENT_ID + _SECRET later). Leave
		// empty to require setting it explicitly before enabling Google sign-in.
		"ALLOWED_AUTH_DOMAINS": "",
		// Used as the From: address on outbound emails via Email Routing.
		// Change to a verified destination on your domain.
		"DEFAULT_FROM_EMAIL": "agent@example.com",
		"DEFAULT_FROM_NAME": "Office Town Agent"
	},

	"triggers": {
		"crons": ["0 */6 * * *"]
	},

	"placement": { "mode": "smart" }
}
