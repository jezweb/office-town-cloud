# Secrets for the Office Town worker.
# When deploying via the "Deploy to Cloudflare" button, Cloudflare reads
# this file and prompts you to fill in each value during the deploy flow.
# Empty defaults force you to provide them.

# REQUIRED — gates the HTTP API + all 4 MCP servers (wiki, files, browser, email).
# Generate via: openssl rand -hex 32
MCP_BEARER_TOKEN=

# REQUIRED — better-auth session secret for the dashboard.
# Generate via: openssl rand -hex 32
BETTER_AUTH_SECRET=

# OPTIONAL — for dashboard Google sign-in.
# Get from https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
